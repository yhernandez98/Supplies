<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trm_tree" model="ir.ui.view">
        <field name="name">license.trm.tree</field>
        <field name="model">license.trm</field>
        <field name="arch" type="xml">
            <list string="TRM" class="o_license_module_list" decoration-muted="not active">
                <field name="year"/>
                <field name="month"/>
                <field name="cutoff_day"/>
                <field name="rate" sum="Tasa"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_trm_form" model="ir.ui.view">
        <field name="name">license.trm.form</field>
        <field name="model">license.trm</field>
        <field name="arch" type="xml">
            <form string="TRM" class="o_subscription_form o_license_module_form">
                <header>
                    <button name="action_fetch_trm_from_web_today" type="object" string="Actualizar TRM web hoy" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="cutoff_day"/>
                            <field name="rate"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trm_search" model="ir.ui.view">
        <field name="name">license.trm.search</field>
        <field name="model">license.trm</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Buscar TRM">
                <field name="year"/>
                <field name="month"/>
                <field name="cutoff_day"/>
                <field name="rate"/>
                <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactivas" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_trm" model="ir.actions.act_window">
        <field name="name">TRM (Tasa Representativa del Mercado)</field>
        <field name="res_model">license.trm</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure
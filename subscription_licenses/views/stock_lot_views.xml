<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Las 4 subpestañas de "Elementos y Licenciamiento": product_suppiles ya tiene Sin Costo y Con Costo; aquí añadimos Licencias del Equipo y Licencias del Usuario. -->
    <record id="view_stock_lot_form_license_tab" model="ir.ui.view">
            <field name="name">stock.lot.form.license.tab</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="product_suppiles.view_production_lot_form_inherit_supplies"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='elementos_y_licencias']/notebook" position="inside">
                    <page string="Licencias del Equipo" name="equipment_licenses" invisible="lot_classification in ('component', 'complement', 'peripheral', 'monitor', 'spare')">
                        <group class="o_license_assignment_pick_group" colspan="4">
                            <button name="action_open_license_assignment_pick_wizard"
                                    type="object"
                                    string="Agregar Asignación"
                                    class="btn-primary o_license_assignment_pick_btn"
                                    context="{'license_tab_type': 'equipment'}"/>
                        </group>
                        <field name="license_line_ids" invisible="1"/>
                        <field name="license_equipment_ids" nolabel="1" class="o_license_no_inline_add"
                               context="{'default_lot_id': id, 'search_default_assigned': 1, 'default_assignment_date': context_today(), 'license_tab_type': 'equipment'}">
                            <list string="Licencias Asignadas al Equipo" default_order="assignment_date desc" decoration-muted="state == 'unassigned'" create="false" edit="false" delete="true">
                                <field name="available_assignment_ids" column_invisible="1"/>
                                <field name="assignment_id" string="Asignación" domain="[('id', 'in', available_assignment_ids)]" options="{'no_create': True}" readonly="1"/>
                                <field name="license_id" string="Categoria"/>
                                <field name="service_product_id" string="Licencia"/>
                                <field name="assignment_date" string="Fecha Asignación"/>
                                <field name="unassignment_date" string="Fecha Desasignación"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'assigned'"
                                       decoration-muted="state == 'unassigned'"
                                       string="Estado"/>
                            </list>
                        </field>
                    </page>
                    <page string="Licencias del Usuario" name="user_licenses" invisible="lot_classification in ('component', 'complement', 'peripheral', 'monitor', 'spare')">
                        <group class="o_license_assignment_pick_group" colspan="4">
                            <button name="action_open_license_assignment_pick_wizard"
                                    type="object"
                                    string="Agregar Asignación"
                                    class="btn-primary o_license_assignment_pick_btn"
                                    context="{'license_tab_type': 'user'}"/>
                        </group>
                        <field name="related_partner_id" invisible="1"/>
                        <field name="license_user_ids" nolabel="1" class="o_license_no_inline_add"
                               context="{'default_contact_id': related_partner_id, 'default_lot_id': id, 'search_default_assigned': 1, 'default_assignment_date': context_today(), 'license_tab_type': 'user'}">
                            <list string="Licencias ya asignadas a este usuario (y disponibles en contrato)" default_order="assignment_date desc" decoration-muted="state == 'unassigned'" create="false" edit="false" delete="false">
                                <field name="available_assignment_ids" column_invisible="1"/>
                                <field name="assignment_id" string="Asignación" domain="[('id', 'in', available_assignment_ids)]" options="{'no_create': True}" readonly="1"/>
                                <field name="contact_id" column_invisible="1"/>
                                <field name="license_id" string="Categoria"/>
                                <field name="service_product_id" string="Licencia"/>
                                <field name="assignment_date" string="Fecha Asignación"/>
                                <field name="unassignment_date" string="Fecha Desasignación"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'assigned'"
                                       decoration-muted="state == 'unassigned'"
                                       string="Estado"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
    </record>
</odoo>

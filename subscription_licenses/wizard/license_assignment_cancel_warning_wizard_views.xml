<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_license_assignment_cancel_warning_wizard_form" model="ir.ui.view">
        <field name="name">license.assignment.cancel.warning.wizard.form</field>
        <field name="model">license.assignment.cancel.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Advertencia - Cancelar asignación" class="o_subscription_form">
                <sheet>
                    <group class="oe_inline">
                        <field name="assignment_id" invisible="1"/>
                        <field name="partner_name" readonly="1"/>
                        <field name="license_label" readonly="1"/>
                    </group>
                    <div class="mt-3">
                        <field name="warning_message" nolabel="1" readonly="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm_cancel" string="Sí, cancelar asignación" type="object" class="btn-danger"/>
                    <button string="No, volver" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

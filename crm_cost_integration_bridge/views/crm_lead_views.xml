<?xml version="1.0" encoding="utf-8"?>
<data>
    <record id="view_crm_lead_form_integration_bridge" model="ir.ui.view">
        <field name="name">crm.lead.form.integration.bridge</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_integration_cases"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-link"
                        invisible="integration_case_count == 0">
                    <field name="integration_case_count" widget="statinfo" string="Integración"/>
                </button>
            </xpath>
        </field>
    </record>
</data>

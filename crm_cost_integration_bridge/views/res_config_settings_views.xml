<?xml version="1.0" encoding="utf-8"?>
<data>
    <record id="res_config_settings_view_form_integration_bridge" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.integration.bridge</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Integración CRM Compras Calculadora" name="crm_cost_integration_bridge" groups="base.group_system">
                    <block title="Flujo operativo">
                        <setting string="Política de ejecución operativa">
                            <field name="integration_execution_policy"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</data>
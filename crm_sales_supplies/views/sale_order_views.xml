<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extender vista de Sale Order -->
        <record id="view_sale_order_form_sales_supplies" model="ir.ui.view">
            <field name="name">sale.order.form.sales.supplies</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Agregar campos en el encabezado -->
                <xpath expr="//field[@name='state']" position="after">
                    <field name="has_stock_issues" invisible="1"/>
                    <field name="stock_availability_summary" invisible="1"/>
                    <field name="has_physical_products" invisible="1"/>
                </xpath>

                <!-- Selector de producto/servicio desde la lista de precios + suscripción del cliente -->
                <xpath expr="//field[@name='pricelist_id']" position="after">
                    <field name="pricelist_product_available_ids" invisible="1"/>
                    <field name="pricelist_product_id"
                           placeholder="Seleccione producto o servicio de la lista de precios"
                           options="{'no_quick_create': false, 'no_create_edit': false}"/>
                    <button name="action_add_pricelist_product_line"
                            type="object"
                            string="Agregar línea"
                            class="btn-secondary"
                            invisible="state not in ('draft', 'sent') or not pricelist_product_id"/>
                    <field name="chosen_subscription_id"
                           placeholder="Seleccione suscripción del cliente o cree una nueva"
                           options="{'no_quick_create': false, 'no_create_edit': false}"/>
                </xpath>

                <!-- Acciones CRM resumidas en smart buttons -->
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button type="object"
                            name="action_request_purchase_quotation"
                            class="oe_stat_button"
                            icon="fa-shopping-cart"
                            invisible="state != 'draft'"
                            title="Crear alerta de cotización y asignar actividad a compras">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Solicitar compra</span>
                        </div>
                    </button>
                    <button type="object"
                            name="action_view_purchase_alerts"
                            class="oe_stat_button"
                            icon="fa-exclamation-triangle"
                            invisible="purchase_alert_count == 0"
                            title="Ver las alertas de compra relacionadas con esta cotización">
                        <field name="purchase_alert_count" widget="statinfo" string="Alertas de compra"/>
                    </button>
                </xpath>

                <!-- Mostrar resumen de disponibilidad de stock -->
                <xpath expr="//sheet" position="before">
                    <div class="alert alert-warning" role="alert" invisible="not has_stock_issues">
                        <strong>⚠️ Advertencia:</strong> Esta orden tiene productos sin stock suficiente.
                        <div class="mt-2" invisible="not stock_availability_summary">
                            <field name="stock_availability_summary" readonly="1" nolabel="1" invisible="not stock_availability_summary"/>
                        </div>
                    </div>
                </xpath>

                <!-- Ocultar pestaña "Líneas de Renting" -->
                <xpath expr="//page[@name='renting_lines_page']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- Ocultamiento de columnas en order_line desactivado temporalmente por compatibilidad de arquitectura en Odoo 19. -->
            </field>
        </record>
    </data>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Solo creamos el notebook para que mesa_ayuda y subscription_nocount puedan añadir sus pestañas (//sheet/notebook). Sin campos propios para evitar fallos de validación. -->
    <record id="view_production_lot_form_inherit_supplies" model="ir.ui.view">
      <field name="name">production.lot.form.supplies.inherit</field>
      <field name="model">stock.lot</field>
      <field name="inherit_id" ref="stock.view_production_lot_form"/>
      <field name="priority" eval="16"/>
      <field name="arch" type="xml">
        <xpath expr="//group[@name='main_group']" position="after">
          <notebook>
            <page string="Supplies" name="supplies_tab">
              <group string="Información Supplies"/>
            </page>
          </notebook>
        </xpath>
      </field>
    </record>
  </data>
</odoo>

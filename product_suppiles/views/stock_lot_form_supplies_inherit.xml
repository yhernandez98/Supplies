<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Igual que inventory_dashboard_simple: un solo xpath sobre campo que existe. Solo un campo para probar. -->
        <record id="view_production_lot_form_inherit_supplies" model="ir.ui.view">
            <field name="name">production.lot.form.supplies.inherit</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="priority" eval="16"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="inventory_plate" string="Placa de Inventario" placeholder="Ingrese la placa de inventario"/>
                    <field name="entry_date" string="Fecha Activación Renting" optional="show"/>
                </xpath>
                <!-- Estructura mínima para que no falle ningún módulo que hereda esta vista:
                     - mesa_ayuda_inventario: //sheet/notebook
                     - subscription_licenses: //page[@name='info_group']/notebook
                     - auto_link_components: //page[@name='supplies_components'] -->
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="Información" name="info_group">
                            <notebook/>
                        </page>
                        <page string="Elementos Asociados" name="supplies_components"/>
                    </notebook>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

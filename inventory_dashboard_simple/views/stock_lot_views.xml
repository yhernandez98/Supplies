<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Heredar vista de stock.lot para mostrar referencia interna como Many2one -->
        <record id="view_stock_lot_form_inherit_internal_ref" model="ir.ui.view">
            <field name="name">stock.lot.form.inherit.internal.ref</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="priority" eval="20"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='ref']" position="replace">
                    <field name="internal_ref_id" 
                           options="{'no_open': True}"
                           context="{'default_product_id': product_id, 'search_default_product_id': product_id}"
                           placeholder="Seleccione o cree una referencia interna"/>
                </xpath>
            </field>
        </record>

        <!-- Vista de búsqueda para lotes con campos incompletos (sin group_by: evita Invalid view en Odoo 19) -->
        <record id="view_stock_lot_incomplete_fields_search" model="ir.ui.view">
            <field name="name">stock.lot.incomplete.fields.search</field>
            <field name="model">stock.lot</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Buscar Productos Pendientes">
                    <field name="display_contact_id" string="Contacto" 
                           filter_domain="['|', ('display_contact_id.name', 'ilike', self), ('display_contact_id.display_name', 'ilike', self)]"/>
                    <field name="name" string="Número de Serie"/>
                    <field name="inventory_plate" string="Placa de Inventario"/>
                    <field name="product_id" string="Producto"/>
                    <field name="billing_code" string="Código de Facturación"/>
                    <field name="entry_date" string="Fecha Activación Renting"/>
                    <separator/>
                    <filter name="with_contact" string="Con contacto" domain="[('display_contact_id', '!=', False)]"/>
                    <filter name="without_contact" string="Sin contacto" domain="[('display_contact_id', '=', False)]"/>
                    <filter name="with_location" string="Con ubicación" domain="[('display_location_id', '!=', False)]"/>
                    <filter name="without_location" string="Sin ubicación" domain="[('display_location_id', '=', False)]"/>
                    <separator/>
                    <filter name="group_contact" string="Agrupar por Contacto" context="{'group_by': 'display_contact_id'}"/>
                    <filter name="group_location" string="Agrupar por Ubicación" context="{'group_by': 'display_location_id'}"/>
                    <filter name="group_product" string="Agrupar por Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_asset_category" string="Agrupar por Categoría Activo" context="{'group_by': 'product_asset_category_id'}"/>
                    <filter name="group_asset_class" string="Agrupar por Clase Activo" context="{'group_by': 'product_asset_class_id'}"/>
                </search>
            </field>
        </record>

        <!-- Vista de lista para lotes con campos incompletos -->
        <record id="view_stock_lot_incomplete_fields_list" model="ir.ui.view">
            <field name="name">stock.lot.incomplete.fields.list</field>
            <field name="model">stock.lot</field>
            <field name="arch" type="xml">
                <list string="Productos Pendientes de Información" 
                      default_order="display_contact_id,name"
                      editable="top"
                      create="0">
                    <field name="name" string="Número de Serie" readonly="1"/>
                    <field name="inventory_plate" string="Placa de Inventario"/>
                    <field name="billing_code" string="Código de Facturación"/>
                    <field name="entry_date" string="Fecha Activación Renting"/>
                    <field name="subscription_service_product_id" string="Servicio"
                           options="{'no_open': True}"
                           context="{'default_type': 'service'}"/>
                    <field name="active_subscription_id" string="Suscripción"
                           options="{'no_open': True}"/>
                    <field name="product_id" readonly="1"/>
                    <field name="product_asset_category_id" string="Categoría de Activo" readonly="1" optional="hide"/>
                    <field name="product_asset_class_id" string="Clase de Activo" readonly="1" optional="hide"/>
                    <field name="display_location_id" string="Ubicación" readonly="1" optional="hide"/>
                    <field name="display_contact_id" string="Contacto" readonly="1" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Acción para ver lotes con campos incompletos -->
        <record id="action_stock_lot_incomplete_fields" model="ir.actions.act_window">
            <field name="name">Productos Pendientes de Información</field>
            <field name="res_model">stock.lot</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_stock_lot_incomplete_fields_list"/>
            <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_stock_lot_incomplete_fields_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_production_lot_form')})]"/>
            <field name="search_view_id" ref="view_stock_lot_incomplete_fields_search"/>
            <field name="domain" eval="[('invdash_pending_info', '=', True)]"/>
            <!-- Agrupación por defecto: Cliente -> Categoría de activo -> Clase de activo. -->
            <field name="context">{'group_by': ['display_contact_id', 'product_asset_category_id', 'product_asset_class_id']}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No hay productos pendientes de información
                </p>
                <p>
                    Esta vista muestra todos los productos (lotes/series) de todas las ubicaciones que tienen al menos uno de estos campos vacíos:
                    <ul>
                        <li><strong>Placa de Inventario</strong></li>
                        <li><strong>Código de Facturación</strong></li>
                        <li><strong>Fecha Activación Renting</strong></li>
                        <li><strong>Servicio</strong></li>
                        <li><strong>Suscripción</strong></li>
                    </ul>
                    No se incluyen equipos que estén en ubicaciones internas del árbol <strong>Supp/…</strong>
                    (Existencias, Alistamiento, Laboratorio, Reparación, etc.; inventario propio Supplies).
                    Tampoco se incluyen productos clasificados como <strong>Componente</strong> o <strong>Periférico</strong>.
                    La vista está <strong>agrupada por cliente, categoría de activo y clase de activo</strong> por defecto.
                    Puedes editar cada lote para completar la información faltante. Los lotes se muestran con colores de advertencia para facilitar su identificación.
                </p>
            </field>
        </record>

        <record id="action_open_stock_lot_incomplete_fields_refreshed" model="ir.actions.server">
            <field name="name">Abrir Productos Pendientes (refrescado)</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="state">code</field>
            <field name="code">action = env['stock.lot'].action_open_incomplete_fields_refreshed()</field>
        </record>
    </data>
</odoo>

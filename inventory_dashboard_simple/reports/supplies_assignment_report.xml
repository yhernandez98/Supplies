                            <td><span t-esc="doc.old_lot_id.model_name or ''"/></td>
                            <td><span t-esc="doc.old_lot_id.name or ''"/></td>
                            <td><span t-esc="doc.old_lot_id.security_plate or ''"/></td>
                            <td><span t-esc="doc.old_lot_id.inventory_plate or ''"/></td>
                        </tr>
                    </table>
                    <h4 style="margin:10px 0 6px 0;">Equipos entregados</h4>
                    <table class="sa_table">
                        <tr>
                            <th>ACTIVO</th><th>MARCA</th><th>MODELO</th><th>SERIAL</th><th>PLACA SEGURIDAD</th><th>PLACA INVENTARIO</th>
                        </tr>
                        <tr>
                            <td><span t-esc="doc.new_product_id.display_name or ''"/></td>
                            <td><span t-esc="doc.new_product_id.name or ''"/></td>
                            <td><span t-esc="doc.new_lot_id.model_name or ''"/></td>
                            <td><span t-esc="doc.new_lot_id.name or ''"/></td>
                            <td><span t-esc="doc.new_lot_id.security_plate or ''"/></td>
                            <td><span t-esc="doc.new_lot_id.inventory_plate or ''"/></td>
                        </tr>
                    </table>
                    <p style="margin:10px 0 0 0;"><strong>Estado de entrega de los equipos:</strong></p>
                    <div style="height:10px;"></div>
                    <p style="margin:0 0 6px 0;"><span t-esc="doc._normalize_report_text(doc.note or 'Sin observaciones')"/></p>
                    <div style="height:40px;"></div>
                    <div style="height:24px;"></div>
                    <table class="sa_sign" style="margin-top:20px;">
                        <tr>
                            <td>
                                <strong>Entrega</strong>
                                <div t-if="assignment_doc and assignment_doc.signature_delivery" style="margin-top:6px;">
                                    <img t-att-src="image_data_uri(assignment_doc.signature_delivery)" style="max-height:45px; max-width:180px;"/>
                                </div>
                                <div class="sa_line"/>
                                <div>Nombre: <span t-esc="delivery_name_clean"/></div>
                                <div>Cargo: <span t-esc="delivery_job_clean"/></div>
                            </td>
                            <td>
                                <strong>Recibe</strong>
                                <div t-if="assignment_doc and assignment_doc.signature_receiver" style="margin-top:6px;">
                                    <img t-att-src="image_data_uri(assignment_doc.signature_receiver)" style="max-height:45px; max-width:180px;"/>
                                </div>
                                <div class="sa_line"/>
                                <div>Nombre: <span t-esc="user_name_clean"/></div>
                                <div>Cargo: <span t-esc="receiver_job_clean"/></div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>


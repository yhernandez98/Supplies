<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_route_validation_wizard_form" model="ir.ui.view">
        <field name="name">delivery.route.validation.wizard.form</field>
        <field name="model">delivery.route.validation.wizard</field>
        <field name="arch" type="xml">
            <form string="Validación ruta de entrega"
                  class="o_delivery_route_validation_wizard o_route_trigger_wizard">
                <sheet>
                    <field name="picking_id" invisible="1"/>
                    <field name="validation_type" invisible="1"/>
                    <div class="o_route_wizard_hero">
                        <div class="o_route_wizard_hero_inner">
                            <div class="o_route_wizard_title o_route_wizard_title_inline">
                                <field name="title" readonly="1" nolabel="1"/>
                            </div>
                            <p class="o_route_wizard_subtitle mb-0">
                                <field name="subtitle" readonly="1" nolabel="1"/>
                            </p>
                        </div>
                    </div>
                    <div class="o_route_wizard_lines_hint">
                        Revise cada serial indicado abajo y complete la información faltante
                        desde el albarán antes de validar.
                    </div>
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" edit="0"
                              class="o_route_wizard_line_list">
                            <field name="detail" string="Pendiente"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Cerrar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

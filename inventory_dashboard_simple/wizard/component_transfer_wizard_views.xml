<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_component_transfer_wizard_line_tree" model="ir.ui.view">
        <field name="name">component.transfer.wizard.line.tree</field>
        <field name="model">component.transfer.wizard.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="true" delete="true">
                <field name="available_lot_ids" invisible="1" column_invisible="1"/>
                <field name="available_product_ids" invisible="1" column_invisible="1"/>
                <field name="product_id"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="Seleccione producto..."/>
                <field name="lot_id"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="Buscar serial por placa o número..."/>
                <field name="available_qty" readonly="1" invisible="1" column_invisible="1"/>
                <field name="quantity" invisible="1" column_invisible="1"/>
                <field name="product_uom_id" readonly="1" invisible="1" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_component_transfer_wizard_form" model="ir.ui.view">
        <field name="name">component.transfer.wizard.form</field>
        <field name="model">component.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Traslado Componente" class="o_lab_hub_form">
                <sheet>
                    <group>
                        <group>
                            <field name="operation_type"/>
                            <field name="source_location_id" readonly="1" options="{'no_open': True}"/>
                            <field name="responsible_user_id"
                                   options="{'no_open': True}"
                                   invisible="operation_type != 'exist_to_lab'"
                                   required="operation_type == 'exist_to_lab'"/>
                        </group>
                        <group>
                            <field name="destination_location_id" readonly="1" options="{'no_open': True}"/>
                            <field name="assigned_technician_user_id"
                                   options="{'no_open': True}"
                                   invisible="operation_type != 'exist_to_lab'"/>
                            <field name="loan_source_picking_id"
                                   options="{'no_open': True}"
                                   invisible="operation_type != 'lab_to_exist'"
                                   domain="['&amp;', '&amp;', ('component_lab_loan_active', '=', True), ('state', '=', 'done'), '|', ('lab_responsible_user_id', '=', uid), ('lab_technician_user_id', '=', uid)]"
                                   placeholder="Seleccione el préstamo que cierra con esta devolución..."/>
                            <field name="note" placeholder="Observación opcional..."/>
                        </group>
                    </group>
                    <group>
                        <field name="available_lot_ids" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Seriales a trasladar">
                            <field name="line_ids" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_process_transfer" type="object" string="Procesar traslado" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_component_transfer_wizard" model="ir.actions.act_window">
        <field name="name">Traslado Componente</field>
        <field name="res_model">component.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_component_transfer_wizard_form"/>
    </record>

    <record id="action_component_transfer_wizard_lab_ingreso" model="ir.actions.act_window">
        <field name="name">Traslado Componente</field>
        <field name="res_model">component.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_component_transfer_wizard_form"/>
        <field name="context">{'default_operation_type': 'exist_to_lab'}</field>
    </record>
</odoo>


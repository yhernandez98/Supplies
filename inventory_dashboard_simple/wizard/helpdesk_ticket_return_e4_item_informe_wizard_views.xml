<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_ticket_return_e4_item_informe_wizard_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.return.e4.item.informe.wizard.form</field>
        <field name="model">helpdesk.ticket.return.e4.item.informe.wizard</field>
        <field name="arch" type="xml">
            <form string="Informe de revisión">
                <sheet>
                    <div class="oe_title mb-3">
                        <h1>Informe de revisión</h1>
                        <p class="text-muted mb-0" invisible="informe_is_principal_group">
                            Redacte el informe técnico del equipo. El contenido se guarda en el ticket E4.
                        </p>
                        <p class="text-muted mb-0" invisible="not informe_is_principal_group">
                            Informe compartido del equipo principal y sus componentes empaquetados.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="item_id" invisible="1"/>
                            <field name="ticket_id" invisible="1"/>
                            <field name="informe_readonly" invisible="1"/>
                            <field name="informe_is_principal_group" invisible="1"/>
                            <field name="line_role_label" string="Rol"/>
                            <field name="lot_id" string="Serial"/>
                        </group>
                        <group>
                            <field name="product_id" string="Producto"/>
                            <field name="informe_group_summary" string="Componentes incluidos"
                                   invisible="not informe_is_principal_group"/>
                        </group>
                    </group>
                    <label for="informe_html" string="Informe"/>
                    <field name="informe_html" nolabel="1"
                           widget="html"
                           readonly="informe_readonly"
                           placeholder="Escriba aquí el informe de revisión…"
                           options="{'style-inline': true, 'codeview': true}"/>
                </sheet>
                <footer>
                    <button name="action_save_informe"
                            string="Guardar informe"
                            type="object"
                            class="btn-primary"
                            invisible="informe_readonly"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

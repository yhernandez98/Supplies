<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Informe PDF detallado de proforma: líneas + detalle por grupo (seriales, tipos de licencia, etc.) -->
    <record id="action_report_proforma_detailed" model="ir.actions.report">
        <field name="name">Informe PDF detallado</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">subscription_nocount.report_proforma_detailed</field>
        <field name="report_file">subscription_nocount.report_proforma_detailed</field>
        <field name="print_report_name">'Informe Proforma - %s' % (object.name or 'Borrador')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_proforma_detailed">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-if="doc.x_is_proforma">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <!-- Título y datos del documento -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h2 class="text-center">Informe detallado - Proforma</h2>
                                    <p class="text-muted text-center mb-0"><t t-esc="doc.name"/> · <t t-esc="doc.invoice_date"/></p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-6">
                                    <strong>Cliente:</strong> <t t-esc="doc.partner_id.name"/>
                                </div>
                                <div class="col-6">
                                    <strong>Origen:</strong> <t t-esc="doc.invoice_origin or '-'"/>
                                </div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-6">
                                    <strong>Moneda:</strong> <t t-esc="doc.currency_id.name"/>
                                </div>
                            </div>

                            <!-- Líneas agrupadas con detalle (secciones + líneas de producto + detalle por serial) -->
                            <t t-foreach="doc.invoice_line_ids" t-as="line">
                                <!-- Línea de tipo sección: encabezado de grupo -->
                                <t t-if="line.display_type == 'line_section'">
                                    <div class="row mt-4 mb-2">
                                        <div class="col-12">
                                            <h4 class="border-bottom pb-1" style="border-color: #dee2e6;"><t t-esc="line.name"/></h4>
                                        </div>
                                    </div>
                                </t>
                                <!-- Subtotal del grupo (line_note con texto "Subtotal X: $ Y") -->
                                <t t-if="line.display_type == 'line_note' and line.name">
                                    <div class="row mb-2">
                                        <div class="col-12 text-end">
                                            <strong><t t-esc="line.name"/></strong>
                                        </div>
                                    </div>
                                </t>
                                <!-- Línea de producto: resumen + tabla de detalles si aplica -->
                                <t t-if="line.display_type not in ('line_section', 'line_subsection', 'line_note')">
                                    <div class="row mb-3">
                                        <div class="col-12">
                                            <table class="table table-sm table-bordered mb-1" style="font-size: 0.9rem;">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Producto / Descripción</th>
                                                        <th class="text-end">Cantidad</th>
                                                        <th class="text-end">Importe</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td>
                                                            <strong><t t-esc="line.subscription_line_display_name or line.name or '-'"/></strong>
                                                            <t t-if="line.subscription_business_line_id">
                                                                <br/><span class="text-muted">Línea de negocio: <t t-esc="line.subscription_business_line_id.name"/></span>
                                                            </t>
                                                        </td>
                                                        <td class="text-end"><t t-esc="'%.2f' % (line.quantity or 0)"/></td>
                                                        <td class="text-end">
                                                            <t t-if="doc.move_type in ('in_invoice', 'in_refund', 'in_receipt')">
                                                                <t t-esc="(doc.currency_id or doc.company_id.currency_id).format(line.price_subtotal or 0)"/>
                                                            </t>
                                                            <t t-else="">
                                                                <t t-esc="(doc.currency_id or doc.company_id.currency_id).format(line.price_total or 0)"/>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>

                                            <!-- Detalle por serial / tipo (lo que muestra Ver Detalles) -->
                                            <t t-set="billable_line" t-value="line.subscription_billable_line_id"/>
                                            <t t-if="billable_line and billable_line.detail_ids">
                                                <div class="ms-3 mb-2">
                                                    <strong class="text-muted" style="font-size: 0.85rem;">Detalle</strong>
                                                    <table class="table table-sm table-striped" style="font-size: 0.8rem;">
                                                        <thead>
                                                            <tr class="table-light">
                                                                <t t-if="billable_line.is_license">
                                                                    <th>Producto</th>
                                                                    <th>Nº serie/lote</th>
                                                                    <th>Placa inventario</th>
                                                                    <th>Licencia/Servicio</th>
                                                                </t>
                                                                <t t-else="">
                                                                    <th>Producto</th>
                                                                    <th>Placa</th>
                                                                    <th>Nº serie/lote</th>
                                                                    <th class="text-end">Costo Renting</th>
                                                                    <th class="text-end">Costo Adicional</th>
                                                                    <th>Activación</th>
                                                                    <th>Finalización</th>
                                                                    <th>Plazo</th>
                                                                    <th class="text-end">Días servicio</th>
                                                                    <th class="text-end">Costo días servicio</th>
                                                                </t>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <t t-foreach="billable_line.detail_ids" t-as="d">
                                                                <tr>
                                                                    <t t-if="billable_line.is_license">
                                                                        <td><t t-esc="d.product_name or '-'"/></td>
                                                                        <td><t t-esc="d.lot_name or '-'"/></td>
                                                                        <td><t t-esc="d.inventory_plate or '-'"/></td>
                                                                        <td><t t-esc="d.license_service_name or '-'"/></td>
                                                                    </t>
                                                                    <t t-else="">
                                                                        <td><t t-esc="d.product_name or '-'"/></td>
                                                                        <td><t t-esc="d.inventory_plate or '-'"/></td>
                                                                        <td><t t-esc="d.lot_name or '-'"/></td>
                                                                        <td class="text-end"><t t-esc="d.currency_id.format(d.cost_renting_total or 0)"/></td>
                                                                        <td class="text-end"><t t-esc="d.currency_id.format(d.cost_additional or 0)"/></td>
                                                                        <td><t t-esc="d.entry_date or '-'"/></td>
                                                                        <td><t t-esc="d.exit_date or '-'"/></td>
                                                                        <td><t t-esc="d.reining_plazo or '-'"/></td>
                                                                        <td class="text-end"><t t-esc="d.days_in_service or 0"/></td>
                                                                        <td class="text-end"><t t-esc="d.currency_id.format(d.cost_to_date or 0)"/></td>
                                                                    </t>
                                                                </tr>
                                                            </t>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </t>

                            <!-- Totales (usa valor actual: con IVA si Aplicar IVA está marcado, sin IVA si no) -->
                            <div class="row mt-4">
                                <div class="col-12 text-end">
                                    <table class="table table-sm w-auto ms-auto" style="max-width: 320px;">
                                        <t t-if="doc.amount_untaxed != doc.amount_total">
                                            <tr>
                                                <td class="text-end">Subtotal:</td>
                                                <td class="text-end"><t t-esc="doc.currency_id.format(doc.amount_untaxed or 0)"/></td>
                                            </tr>
                                            <tr>
                                                <td class="text-end">IVA:</td>
                                                <td class="text-end"><t t-esc="doc.currency_id.format((doc.amount_total or 0) - (doc.amount_untaxed or 0))"/></td>
                                            </tr>
                                        </t>
                                        <tr>
                                            <td class="text-end"><strong>Total:</strong></td>
                                            <td class="text-end"><strong><t t-esc="doc.currency_id.format(doc.amount_total or 0)"/></strong></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
                <!-- Si no es proforma, página en blanco con mensaje -->
                <t t-else="">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <p class="text-center text-muted mt-5">Este informe es solo para proformas (documentos del diario de proformas).</p>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>

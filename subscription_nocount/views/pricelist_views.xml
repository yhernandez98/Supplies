<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Al abrir la lista de precios, mostrar primero "Precios recurrentes" (pestaña por defecto). -->
    <record id="view_pricelist_form_recurring_tab_first" model="ir.ui.view">
        <field name="name">product.pricelist.form.recurring.tab.first</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="sale_subscription.product_pricelist_view"/>
        <field name="priority" eval="55"/>
        <field name="arch" type="xml">
            <xpath expr="//page[.//field[@name='item_ids']]" position="before">
                <xpath expr="//page[.//field[@name='subscription_item_ids']]" position="move"/>
            </xpath>
        </field>
    </record>

    <!-- Odoo 19: Precios recurrentes = product.pricelist.item con plan_id (pestaña Recurring Prices).
         Añadimos columnas Cantidad y Moneda para discriminar COP/USD (suscripciones dependen de esto). -->
    <record id="view_pricelist_form_inherit_currency" model="ir.ui.view">
        <field name="name">product.pricelist.form.subscription_nocount.currency</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="sale_subscription.product_pricelist_view"/>
        <field name="priority" eval="25"/>
        <field name="arch" type="xml">
            <!-- Lista dentro de la pestaña "Recurring Prices" (subscription_item_ids) -->
            <xpath expr="//field[@name='subscription_item_ids']/list/field[@name='plan_id']" position="after">
                <field name="client_quantity" string="Cantidad" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='subscription_item_ids']/list/field[@name='price']" position="after">
                <field name="currency_id" string="Moneda" optional="show"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Formulario de línea de precio recurrente: mostrar Moneda para poder editar COP/USD al abrir una línea -->
    <record id="view_pricelist_item_form_recurring_currency" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.recurring.currency</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="sale_subscription.product_pricelist_item_form_view_recurring"/>
        <field name="arch" type="xml">
            <field name="plan_id" position="after">
                <field name="currency_id" string="Moneda" domain="[('name', 'in', ['COP', 'USD'])]" options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>

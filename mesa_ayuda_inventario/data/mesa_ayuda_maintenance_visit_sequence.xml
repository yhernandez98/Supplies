<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Código único del módulo: evita colisión con otras secuencias "maintenance.order" en la misma BD -->
    <data noupdate="1">
        <record id="seq_mesa_ayuda_maintenance_order" model="ir.sequence">
            <field name="name">Secuencia visita técnica (Mesa ayuda)</field>
            <field name="code">mesa.ayuda.maintenance.order</field>
            <field name="prefix">VS-</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>
    </data>
</odoo>

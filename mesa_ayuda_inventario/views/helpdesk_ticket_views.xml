<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista lista mínima para tickets -->
        <record id="view_helpdesk_ticket_list" model="ir.ui.view">
            <field name="name">helpdesk.ticket.list</field>
            <field name="model">helpdesk.ticket</field>
            <field name="arch" type="xml">
                <list string="Tickets" class="mesa_helpdesk_ticket_list">
                    <field name="id" string="ID"/>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="category_id" optional="show"/>
                    <field name="maintenance_order_id" optional="hide" string="Orden"/>
                    <field name="urgency" optional="hide"/>
                    <field name="impact" optional="hide"/>
                    <field name="stage_id"/>
                    <field name="user_id"/>
                    <field name="priority"/>
                </list>
            </field>
        </record>

        <record id="view_helpdesk_ticket_form_inherit_category" model="ir.ui.view">
            <field name="name">helpdesk.ticket.form.inherit.category</field>
            <field name="model">helpdesk.ticket</field>
            <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="attributes">
                    <attribute name="class" add="mesa_helpdesk_ticket_executive"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="before">
                    <field name="mesa_ticket_edit_blocked" invisible="1"/>
                    <field name="mesa_category_readonly" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="required">1</attribute>
                    <attribute name="readonly">mesa_ticket_edit_blocked</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="readonly">mesa_ticket_edit_blocked</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="readonly">mesa_ticket_edit_blocked</attribute>
                </xpath>
                <xpath expr="//field[@name='team_id']" position="attributes">
                    <attribute name="help">Equipo de soporte (ej. Nivel 1, Nivel 2). Configurar en: Mesa de Ayuda → Configuración → Equipos.</attribute>
                    <attribute name="readonly">mesa_ticket_edit_blocked</attribute>
                </xpath>
                <!-- Tras cliente: solo campos técnicos (SLA y aviso van tras CC del correo) -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="visit_helpdesk_category_locked" invisible="1"/>
                    <field name="values_from_category" invisible="1"/>
                </xpath>
                <!-- Columna derecha: SLA debajo de CC del correo; aviso debajo de los SLA -->
                <xpath expr="//field[@name='email_cc']" position="after">
                    <field name="date_deadline_response" readonly="1"/>
                    <field name="date_deadline_resolution" readonly="1"/>
                    <div class="alert alert-info mesa_ticket_exec_alert" role="alert" style="margin-top: 12px;">
                        Al cerrar el ticket puede enviarse una encuesta de satisfacción al cliente (app Rating / Valoración de Odoo).
                    </div>
                </xpath>
                <!-- Urgencia / impacto / sede: columna izquierda (más equilibrio con la derecha) -->
                <xpath expr="//field[@name='priority']" position="after">
                    <field name="urgency" readonly="1"/>
                    <field name="impact" readonly="1"/>
                    <field name="location_site" placeholder="Sede o ubicación" readonly="mesa_ticket_edit_blocked"/>
                </xpath>
                <!-- Cronómetro: junto al responsable (evita grupo extra al pie que dibujaba rectángulos vacíos) -->
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="custom_timer_start" invisible="1"/>
                    <field name="custom_timer_accumulated_hours" invisible="1"/>
                    <field name="custom_timer_can_stop" invisible="1"/>
                    <field name="custom_timer_display" readonly="1" string="Cronómetro" class="mesa_ticket_timer_readout fw-bold"/>
                </xpath>
                <xpath expr="//field[@name='stage_id']" position="attributes">
                    <attribute name="readonly">mesa_ticket_edit_blocked</attribute>
                </xpath>
                <xpath expr="//field[@name='priority']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='description']" position="before">
                    <field name="mesa_ticket_detail_html" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='description']" position="attributes">
                    <attribute name="widget">html</attribute>
                    <attribute name="readonly">mesa_ticket_edit_blocked</attribute>
                </xpath>
                <xpath expr="//field[@name='tag_ids']" position="attributes">
                    <attribute name="readonly">mesa_ticket_edit_blocked</attribute>
                </xpath>
                <xpath expr="//field[@name='tag_ids']" position="after">
                    <field name="category_id" readonly="mesa_category_readonly"/>
                    <field name="maintenance_order_id" readonly="1" string="Orden"/>
                    <field name="mesa_hide_visit_acta_notebook_pages" invisible="1"/>
                    <field name="mesa_acta_request_type" invisible="1"/>
 
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mesa_service_solicitudes_wizard_form" model="ir.ui.view">
        <field name="name">mesa.service.solicitudes.wizard.form</field>
        <field name="model">mesa.service.solicitudes.wizard</field>
        <field name="arch" type="xml">
            <form string="Solicitudes">
                <sheet>
                    <div class="alert alert-info mb-3" role="alert">
                        <p class="mb-0">
                            Seleccione el tipo de solicitud que desea registrar.
                            Más opciones podrán añadirse en versiones posteriores.
                        </p>
                    </div>
                    <group string="Tipo de solicitud">
                        <field name="request_type"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Continuar" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mesa_service_solicitudes_wizard" model="ir.actions.act_window">
        <field name="name">Solicitudes</field>
        <field name="res_model">mesa.service.solicitudes.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mesa_service_solicitudes_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>

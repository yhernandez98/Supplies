<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mesa_retiro_inactivate_user_license_prompt_wizard_form" model="ir.ui.view">
        <field name="name">mesa.retiro.inactivate.user.license.prompt.wizard.form</field>
        <field name="model">mesa.retiro.inactivate.user.license.prompt.wizard</field>
        <field name="arch" type="xml">
            <form string="Licencias del usuario">
                <sheet>
                    <field name="retiro_wizard_id" invisible="1"/>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="contact_id" readonly="1"/>
                        <field name="license_count" readonly="1"/>
                    </group>
                    <p class="text-muted">
                        El usuario tiene licencias asignadas (pestaña «Usuarios» en asignación M365).
                        ¿Desea retirar alguna antes de archivar el contacto?
                    </p>
                </sheet>
                <footer>
                    <button name="action_yes_remove_licenses" type="object"
                            string="Sí, elegir licencias a retirar" class="btn-primary"
                            invisible="license_count == 0"/>
                    <button name="action_no_remove_licenses" type="object"
                            string="No retirar licencias" class="btn-secondary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

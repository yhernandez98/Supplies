<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_visit_documentation_wizard_form" model="ir.ui.view">
            <field name="name">mesa.ayuda.visit.documentation.wizard.form</field>
            <field name="model">mesa.ayuda.visit.documentation.wizard</field>
            <field name="arch" type="xml">
                <form string="Informe de visita" create="false" edit="true">
                    <sheet>
                        <group>
                            <field name="maintenance_order_id"/>
                            <field name="ticket_id"/>
                            <field name="partner_id"/>
                        </group>
                        <label for="body_html" string="Detalle de lo realizado (estilo documento)"/>
                        <field name="body_html" widget="html" nolabel="1" placeholder="Describe actividades, hallazgos, repuestos, tiempos, etc."/>
                    </sheet>
                    <footer>
                        <button name="action_save_and_close" type="object" string="Guardar y cerrar" class="btn-primary"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

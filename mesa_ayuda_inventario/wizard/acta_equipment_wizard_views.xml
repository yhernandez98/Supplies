<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acta_equipment_wizard_form" model="ir.ui.view">
        <field name="name">mesa.ayuda.acta.equipment.wizard.form</field>
        <field name="model">mesa.ayuda.acta.equipment.wizard</field>
        <field name="arch" type="xml">
            <form string="Productos principales del cliente" class="mesa_acta_wizard">
                <sheet>
                    <field name="has_acta_equipment_lines" invisible="1"/>
                    <div class="mesa_acta_wizard_header">
                        <p class="mesa_acta_wizard_header__title">Equipos para el acta</p>
                        <p class="mesa_acta_wizard_header__hint">
                            Seleccione los productos principales del cliente que desea insertar en el acta de visita.
                            Use el buscador para acortar la lista; cada ítem aparece como tarjeta seleccionable.
                        </p>
                    </div>
                    <group>
                        <field name="ticket_id"/>
                    </group>
                    <group class="mesa_acta_wizard_filter">
                        <field name="filter_equipment" placeholder="Ej. TRAVELMATE, 5050, placa…" colspan="2"/>
                    </group>
                    <field name="candidate_lot_ids" invisible="1"
                           context="{'mesa_acta_equipment_wizard': True}"/>
                    <div class="mesa_acta_pick_list">
                        <field name="selected_lot_ids" widget="many2many_checkboxes" nolabel="1"
                               context="{'mesa_acta_equipment_wizard': True}"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm_insert" type="object" string="Insertar en el acta" class="btn-primary"
                            invisible="not has_acta_equipment_lines"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

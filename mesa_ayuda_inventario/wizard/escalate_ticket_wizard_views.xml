<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_helpdesk_ticket_escalate_wizard_form" model="ir.ui.view">
            <field name="name">helpdesk.ticket.escalate.wizard.form</field>
            <field name="model">helpdesk.ticket.escalate.wizard</field>
            <field name="arch" type="xml">
                <form string="Escalar ticket" class="mesa_acta_wizard mesa_escalate_wizard">
                    <sheet>
                        <div class="mesa_acta_wizard_header">
                            <p class="mesa_acta_wizard_header__title">Escalar a otro equipo o responsable</p>
                            <p class="mesa_acta_wizard_header__hint">
                                Elija el equipo de soporte y la persona asignada; registre un breve motivo para la trazabilidad.
                            </p>
                        </div>
                        <group>
                            <field name="ticket_id"/>
                            <field name="team_id" options="{'no_create': True}" placeholder="Ej. Nivel 2"/>
                            <field name="user_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Motivo de escalación" class="mesa_es
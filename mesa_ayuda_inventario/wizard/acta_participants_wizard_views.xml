<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acta_participants_wizard_form" model="ir.ui.view">
        <field name="name">mesa.ayuda.acta.participants.wizard.form</field>
        <field name="model">mesa.ayuda.acta.participants.wizard</field>
        <field name="arch" type="xml">
            <form string="Contactos del cliente en el acta" class="mesa_acta_wizard">
                <sheet>
                    <field name="has_acta_participant_lines" invisible="1"/>
                    <div class="mesa_acta_wizard_header">
                        <p class="mesa_acta_wizard_header__title">Contactos en el acta</p>
                        <p class="mesa_acta_wizard_header__hint">
                            Marque los contactos del mismo comercial que el cliente con los que se realizó la visita;
                            se insertarán en el acta y podrán generar ticket hijo al completar la orden.
                        </p>
                    </div>
                    <group>
                        <field name="ticket_id"/>
                    </group>
                    <group class="mesa_acta_wizard_filter">
                        <field name="filter_contact" placeholder="Ej. nombre, correo, teléfono…" colspan="2"/>
                    </group>
                    <field name="candidate_contact_ids" invisible="1"/>
                    <div class="mesa_acta_pick_list">
                        <field name="selected_contact_ids" widget="many2many_checkboxes" nolabel="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm_insert" type="object" string="Insertar en el acta" class="btn-primary"
                            invisible="not has_acta_participant_lines"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mesa_retiro_inactivate_equipment_prompt_wizard_form" model="ir.ui.view">
        <field name="name">mesa.retiro.inactivate.equipment.prompt.wizard.form</field>
        <field name="model">mesa.retiro.inactivate.equipment.prompt.wizard</field>
        <field name="arch" type="xml">
            <form string="Devolución de equipos">
                <sheet>
                    <field name="retiro_wizard_id" invisible="1"/>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="contact_id" readonly="1"/>
                        <field name="equipment_count" readonly="1"/>
                    </group>
                    <p class="text-muted" invisible="equipment_count == 0">
                        El usuario tiene equipos asignados en inventario (según el resumen del retiro).
                        ¿Desea registrar la devolución de alguno antes de inactivar el contacto?
                    </p>
                    <p class="text-muted" invisible="equipment_count != 0">
                        No se detectaron equipos devolvibles con el criterio habitual; puede continuar
                        con licencias y archivado del contacto.
                    </p>
                </sheet>
                <footer>
                    <button name="action_yes_return_equipment" type="object"
                            string="Sí, elegir equipos a devolver" class="btn-primary"
                            invisible="equipment_count == 0"/>
                    <button name="action_no_return_equipment" type="object"
                            string="No devolver equipos" class="btn-secondary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

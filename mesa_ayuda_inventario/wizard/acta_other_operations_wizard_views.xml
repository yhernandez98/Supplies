<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acta_other_operations_wizard_form" model="ir.ui.view">
        <field name="name">mesa.ayuda.acta.other.operations.wizard.form</field>
        <field name="model">mesa.ayuda.acta.other.operations.wizard</field>
        <field name="arch" type="xml">
            <form string="Otras operaciones">
                <sheet>
                    <group>
                        <field name="helpdesk_ticket_id"/>
                        <field name="info" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Cerrar" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

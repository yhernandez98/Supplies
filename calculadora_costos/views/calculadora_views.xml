<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_calculadora_form" model="ir.ui.view">
        <field name="name">calculadora.costos.form</field>
        <field name="model">calculadora.costos</field>
        <field name="arch" type="xml">
            <form string="Calculadora de Costos">
                <header>
                    <button name="action_print_report"
                            type="object"
                            string="Imprimir Reporte"
                            icon="fa-print"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="Ej: Equipo All in One / Cotización"/>
                            <field name="tipo_operacion"/>
                            <field name="active"/>
                            <field name="partner_id" domain="[('is_company', '=', True)]" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="moneda_cotizacion" invisible="1"/>
                            <field name="cantidad_equipos" invisible="1"/>
                        </group>
                        <group>
                            <field name="costo_total_cop" widget="monetary"
                                   options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="pago_mensual" widget="monetary"
                                   options="{'currency_field': 'currency_id'}" readonly="1"
                                   invisible="tipo_operacion == 'venta'"/>
                            <field name="subscription_count"
                                   invisible="tipo_operacion != 'suscripcion' or not partner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Costos del Equipo">
                            <group>
                                <group string="Parámetros globales">
                                    <field name="trm"/>
                                    <field name="porcentaje_utilidad"/>
                                </group>
                                <group string="Totales (COP / referencia USD)">
                                    <field name="costo_total_usd" widget="monetary"
                                           options="{'currency_field': 'currency_usd_id'}" readonly="1"/>
                                    <field name="costo_con_utilidad_usd" widget="monetary"
                                           options="{'currency_field': 'currency_usd_id'}" readonly="1"/>
                                    <field name="costo_total_cop" widget="monetary"
                                           options="{'currency_field': 'currency_id'}" readonly="1"/>
                                </group>
                            </group>
                            <group string="Equipos (productos del catálogo; totales en COP)">
                                <field name="line_ids" nolabel="1" colspan="2"
                                       context="{'default_calculadora_id': id, 'default_moneda_equipo': 'USD', 'default_product_qty': 1.0}">
                                    <list string="Líneas de equipo" editable="bottom" create="1" delete="1">
                                        <field name="sequence" widget="handle"/>
                                        <field name="product_id" optional="show"
                                               options="{'no_create': True}"/>
                                        <field name="name" optional="show"/>
                                        <field name="product_qty"/>
                                        <field name="price_unit" widget="monetary"
                                               options="{'currency_field': 'line_currency_id'}"/>
                                        <field name="line_currency_id" column_invisible="1"/>
                                        <field name="moneda_equipo"/>
                                        <field name="product_currency_id" optional="hide" readonly="1"/>
                                        <field name="monto_garantia" optional="show"/>
                                        <field name="equipo_base_cop" optional="show" sum="Total equipo (COP)" readonly="1"/>
                                        <field name="garantia_base_cop" optional="hide"/>
                                        <field name="subtotal_base_cop" string="Subtotal COP" sum="Total COP (sin util.)" readonly="1"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Servicio Técnico" invisible="tipo_operacion != 'suscripcion'">
                            <group>
                                <group string="Servicio técnico (COP, independiente del costo del equipo)">
                                    <field name="costo_servicio_tecnico_mensual_cop"/>
                                    <field name="porcentaje_margen_servicio"/>
                                    <field name="servicio_con_margen" widget="monetary"
                                           options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="total_servicio_tecnico_plazo_cop" widget="monetary"
                                           options="{'currency_field': 'currency_id'}" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Parámetros Financieros" invisible="tipo_operacion != 'suscripcion'">
                            <group>
                                <group string="Modalidad de cuota">
                                    <field name="financiacion_con_interes"/>
                                </group>
                                <group string="Tasas de Interés">
                                    <field name="tasa_nominal"/>
                                    <field name="tasa_mensual" readonly="1"/>
                                    <field name="tasa_efectiva_anual" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Valores por Plazo" invisible="tipo_operacion != 'suscripcion'">
                            <group>
                                <group string="Duración y comparación">
                                    <field name="plazo_meses"/>
                                    <label for="valor_12_meses" string="12 meses"/>
                                    <div>
                                        <field name="valor_12_meses" widget="monetary"
                                               options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    </div>
                                    <label for="valor_24_meses" string="24 meses"/>
                                    <div>
                                        <field name="valor_24_meses" widget="monetary"
                                               options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    </div>
                                    <label for="valor_36_meses" string="36 meses"/>
                                    <div>
                                        <field name="valor_36_meses" widget="monetary"
                                               options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    </div>
                                    <label for="valor_48_meses" string="48 meses"/>
                                    <div>
                                        <field name="valor_48_meses" widget="monetary"
                                               options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    </div>
                                    <label for="valor_60_meses" string="60 meses"/>
                                    <div>
                                        <field name="valor_60_meses" widget="monetary"
                                               options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Suscripciones No Contables" invisible="tipo_operacion != 'suscripcion'">
                            <group>
                                <group>
                                    <label for="partner_id" string="Cliente:"/>
                                    <div>
                                        <field name="partner_id" domain="[('is_company', '=', True)]" options="{'no_create': True, 'no_create_edit': True}"/>
                                    </div>
                                    <label for="subscription_count" string="Suscripciones Activas:"/>
                                    <div>
                                        <field name="subscription_count" readonly="1"/>
                                    </div>
                                    <div>
                                        <button name="action_view_subscriptions"
                                                string="Ver Suscripciones Activas"
                                                type="object"
                                                class="btn-primary"
                                                icon="fa-file-text"
                                                invisible="not partner_id"/>
                                    </div>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert" invisible="partner_id">
                                <strong>Nota:</strong> Seleccione un cliente para ver sus suscripciones no contables activas.
                            </div>
                        </page>
                        <page string="Notas">
                            <group>
                                <field name="notas" placeholder="Notas adicionales sobre el cálculo..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_calculadora_list" model="ir.ui.view">
        <field name="name">calculadora.costos.list</field>
        <field name="model">calculadora.costos</field>
        <field name="arch" type="xml">
            <list string="Calculadoras" decoration-muted="active == False">
                <field name="name"/>
                <field name="tipo_operacion"/>
                <field name="partner_id"/>
                <field name="valor_usd" widget="monetary"
                       options="{'currency_field': 'currency_usd_id'}"/>
                <field name="costo_total_cop" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="pago_mensual" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="plazo_meses"/>
                <field name="subscription_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_calculadora_search" model="ir.ui.view">
        <field name="name">calculadora.costos.search</field>
        <field name="model">calculadora.costos</field>
        <field name="arch" type="xml">
            <search string="Buscar Calculadoras">
                <field name="name" string="Nombre"/>
                <field name="partner_id" string="Cliente"/>
                <field name="tipo_operacion" string="Tipo"/>
                <separator/>
                <filter string="Venta" name="filter_venta" domain="[('tipo_operacion', '=', 'venta')]"/>
                <filter string="Suscripción" name="filter_suscripcion" domain="[('tipo_operacion', '=', 'suscripcion')]"/>
                <filter string="Activos" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Inactivos" name="filter_inactive" domain="[('active', '=', False)]"/>
                <separator string="Agrupar por"/>
                <group>
                    <filter string="Tipo" name="group_tipo" context="{'group_by': 'tipo_operacion'}"/>
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Plazo" name="group_plazo" context="{'group_by': 'plazo_meses'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_calculadora" model="ir.actions.act_window">
        <field name="name">Calculadora de Costos</field>
        <field name="res_model">calculadora.costos</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear nueva calculadora
            </p>
            <p>
                Elija Venta o Suscripción: en Venta solo costos esenciales; en Suscripción incluye servicios,
                financiación y comparación por plazos.
            </p>
        </field>
    </record>
</odoo>

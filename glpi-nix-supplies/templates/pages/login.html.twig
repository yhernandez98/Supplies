{#
 # NIX Login - Supplies de Colombia
 # Sustituye la página de login para GLPI 11.0.6
 # Logo: public/pics/logo_supplies.svg (o reemplazar por logopnghorizontal.png)
 #}
{% extends 'layout/page_card_notlogged.html.twig' %}

{% block nix_brand_block %}
   <div class="nix-logo-link">
      <img src="pics/logo_supplies_login.png" alt="Supplies de Colombia" class="nix-panel-logo"/>
   </div>
   <h1 class="nix-title">Supplies de Colombia</h1>
   <div class="nix-configurable-content">
      {% if text_login is defined and text_login|length > 0 %}
         {{ text_login|safe_html }}
      {% else %}
         <p>En Supplies de Colombia nos dedicamos a ofrecer soluciones excepcionales en tecnología y asistencia técnica personalizada.</p>
         <p>Agradecemos su confianza para atender sus necesidades tecnológicas.</p>
      {% endif %}
   </div>
{% endblock %}

{% block content_block %}
   {# Compatible GLPI 11.0.6: name login_name y login_password como en original #}
   <form action="{{ path('front/login.php') }}" method="post" autocomplete="off" class="nix-form" data-submit-once>
      <input type="hidden" name="noAUTO" value="{{ noAuto }}"/>
      <input type="hidden" name="redirect" value="{{ redirect }}"/>
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"/>

      <div class="nix-form-logo-header">
         <img src="pics/logo_supplies_login.png" alt="Supplies de Colombia" class="nix-form-logo-img"/>
      </div>
      <h2 class="nix-form-title">Iniciar sesión</h2>
      <p class="nix-form-subtitle">Ingresa tus credenciales corporativas</p>

      {% if errors is defined and errors|length > 0 %}
         <div class="alert alert-danger" role="alert">{{ errors }}</div>
      {% endif %}

      <div class="nix-field">
         <label for="login_name" class="form-label">{{ __('Login') }}</label>
         <input type="text" id="login_name" class="form-control" name="login_name" placeholder="{{ __('Login') }}" tabindex="1"/>
      </div>
      <div class="nix-field">
         <label for="login_password" class="form-label">{{ __('Password') }}</label>
         <div class="nix-field-password-wrap">
            <input type="password" id="login_password" class="form-control" name="login_password" placeholder="{{ __('Password') }}" autocomplete="off" tabindex="2"/>
            <button type="button" class="nix-toggle-pw" aria-label="Mostrar contraseña" tabindex="-1" title="Mostrar contraseña">
               <svg class="nix-icon-eye-open" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
               <svg class="nix-icon-eye-closed" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
         </div>
      </div>
      <button type="submit" name="submit" class="btn btn-primary" tabindex="3">{{ __('Sign in') }}</button>

      <div class="nix-form-options">
         {% if show_lost_password|default(false) %}
            <span class="nix-form-label-description">
               <a href="{{ path('front/lostpassword.php?lostpassword=1') }}">{{ __('Forgotten password?') }}</a>
            </span>
         {% endif %}
         {% if config('login_remember_time')|default(false) %}
            <label class="form-check nix-check-remember" for="login_remember">
               <input type="checkbox" class="form-check-input" id="login_remember" name="login_remember" {{ config('login_remember_default') ? 'checked' : '' }}/>
               <span>{{ __('Remember me') }}</span>
            </label>
         {% endif %}
      </div>

      {% if config('display_login_source')|default(false) %}
         <div class="nix-field mt-2">
            <label for="dropdown_auth{{ rand|default('') }}">{{ __('Login source') }}</label>
            {{ auth_dropdown_login|default('')|raw }}
         </div>
      {% endif %}

      <div class="nix-divider"></div>
      <p class="nix-social-label">Síguenos</p>
      <div class="nix-social-links">
         <a href="https://instagram.com/suppliesdecolombia" target="_blank" rel="noopener" title="Instagram" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
         </a>
         <a href="https://www.facebook.com/Suppliesdecolombiasas" target="_blank" rel="noopener" title="Facebook" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
         </a>
         <a href="https://web.whatsapp.com/send?phone=3105543407" target="_blank" rel="noopener" title="WhatsApp" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
         </a>
         <a href="https://supplies.com.co" target="_blank" rel="noopener" title="Visita nuestro sitio" aria-label="Sitio web">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
         </a>
      </div>

      <div class="nix-policy-link">
         <a href="https://www.supplies.com.co/politica-de-proteccion-de-datos-nix/" target="_blank" rel="noopener">Política de protección de datos</a>
      </div>
   </form>
{% endblock %}

{% block footer_block %}
   <div class="nix-footer-copy">
      © {{ "now"|date("Y") }} Supplies de Colombia. Todos los derechos reservados.
   </div>
{% endblock %}

{% block javascript_block %}
<script>
$(function () {
   $('#login_name').focus();
});

(function () {
   var page = document.querySelector('.nix-login-page');
   var btn = document.getElementById('nix-theme-toggle');
   var iconMoon = document.getElementById('nix-icon-moon');
   var iconSun = document.getElementById('nix-icon-sun');
   if (!page || !btn) return;

   var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
   var saved = localStorage.getItem('nix-theme');
   var initial = saved || (systemDark ? 'dark' : 'light');

   function applyTheme(theme) {
      if (theme === 'light') {
         page.classList.add('nix-theme-light');
         if (iconMoon) iconMoon.style.display = 'none';
         if (iconSun) iconSun.style.display = 'block';
         btn.setAttribute('aria-label', 'Cambiar a tema oscuro');
         btn.setAttribute('title', 'Cambiar a tema oscuro');
      } else {
         page.classList.remove('nix-theme-light');
         if (iconMoon) iconMoon.style.display = 'block';
         if (iconSun) iconSun.style.display = 'none';
         btn.setAttribute('aria-label', 'Cambiar a tema claro');
         btn.setAttribute('title', 'Cambiar a tema claro');
      }
      localStorage.setItem('nix-theme', theme);
   }

   applyTheme(initial);

   btn.addEventListener('click', function () {
      var current = localStorage.getItem('nix-theme') || 'dark';
      applyTheme(current === 'dark' ? 'light' : 'dark');
   });
})();

document.querySelector('.nix-form') && document.querySelector('.nix-form').addEventListener('submit', function () {
   var btn = this.querySelector('button[type="submit"]');
   if (!btn || btn.disabled) return;
   btn.disabled = true;
   btn.innerHTML = '<svg class="nix-spinner" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"/></svg> Iniciando sesión…';
});

var togglePw = document.querySelector('.nix-toggle-pw');
var inputPw = document.getElementById('login_password');
if (togglePw && inputPw) {
   togglePw.addEventListener('click', function () {
      var isPassword = inputPw.type === 'password';
      inputPw.type = isPassword ? 'text' : 'password';
      this.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
      this.setAttribute('title', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
      var open = this.querySelector('.nix-icon-eye-open');
      var closed = this.querySelector('.nix-icon-eye-closed');
      if (open && closed) {
         open.style.display = isPassword ? 'block' : 'none';
         closed.style.display = isPassword ? 'none' : 'block';
      }
   });
}
</script>
{% endblock %}

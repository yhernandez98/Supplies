<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_pricelist_debug_wizard_form" model="ir.ui.view">
        <field name="name">partner.pricelist.debug.wizard.form</field>
        <field name="model">partner.pricelist.debug.wizard</field>
        <field name="arch" type="xml">
            <form string="Debug lista de precios">
                <group>
                    <field name="partner_id"/>
                </group>
                <field name="debug_text" widget="text" nolabel="1" placeholder="Generando informe..."/>
                <footer>
                    <button string="Cerrar" class="btn-primary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_partner_set_specific_pricelist_wizard_form" model="ir.ui.view">
        <field name="name">partner.set.specific.pricelist.wizard.form</field>
        <field name="model">partner.set.specific.pricelist.wizard</field>
        <field name="arch" type="xml">
            <form string="Fijar lista específica del cliente">
                <group>
                    <field name="partner_id"/>
                    <field name="company_id"/>
                    <field name="pricelist_id"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

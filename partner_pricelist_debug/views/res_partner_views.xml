<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_pricelist_debug_button" model="ir.ui.view">
        <field name="name">res.partner.form.pricelist.debug</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <!-- Después de las extensiones de sale (donde está Lista de precios) -->
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <!-- Justo encima del campo nativo "Lista de precios" (Ventas y compra) -->
            <xpath expr="//field[@name='property_product_pricelist']" position="before">
                <button name="action_set_specific_pricelist_from_current"
                        type="object"
                        string="Establecer Lista de Precio"
                        groups="base.group_system"
                        class="btn btn-primary me-2 mb-2"
                        colspan="2"
                        title="Abre asistente para fijar una lista específica al cliente y evitar heredar el default por país"/>
            </xpath>
        </field>
    </record>
</odoo>
